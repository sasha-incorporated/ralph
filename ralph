#!/usr/bin/env bash
#
# ralph - AI bead worker loop (YOLO mode)
#
# Autonomous bead worker: picks up ready work, completes it, commits, then
# loops to the next bead. Routes to Claude CLI or Cursor agent based on model.
# Beads with a model:<name> label automatically use that model.
#
# Usage:
#   ralph [--label <label>] [--max <n>] [--model <model>] [--retries <n>]
#   ralph --queue "id:model,id:model,..."
#
# Options:
#   --label <label>   Filter beads by label (works on any beads if omitted)
#   --max <n>         Maximum iterations (default: unlimited)
#   --model <model>   Default model (default: haiku). Claude models (haiku,
#                     sonnet, opus) use Claude CLI; others use Cursor agent.
#   --retries <n>     Max retries per bead (default: 5)
#   --queue <spec>    Explicit queue with per-bead models (format: id:model,id:model,...)
#

set -euo pipefail

# Models that use Claude CLI; everything else routes to cursor agent
CLAUDE_MODELS="haiku sonnet opus"

is_claude_model() {
  [[ " $CLAUDE_MODELS " == *" $1 "* ]]
}

# Extract model from bead labels (looks for model:<name> label)
# Returns the model name or empty string if no model label found
extract_model_from_labels() {
  local labels_json="$1"
  echo "$labels_json" | jq -r '.[] | select(startswith("model:")) | sub("^model:"; "")' 2>/dev/null | head -1
}

# Invoke the right CLI based on model type
invoke_model() {
  local model="$1"
  local prompt="$2"

  if is_claude_model "$model"; then
    claude --model "$model" --print --dangerously-skip-permissions "$prompt" < /dev/null
  else
    cursor agent --model "$model" --print --yolo --trust "$prompt" < /dev/null
  fi
}

# Defaults
LABEL=""
MAX_ITERATIONS="unlimited"
MODEL="haiku"
MAX_RETRIES=5
QUEUE=""

# Help text
show_help() {
  cat <<EOF
ralph - AI bead worker loop (YOLO mode)

Autonomous bead worker: picks up ready work, completes it, commits, then
loops to the next bead. Fully autonomous - no confirmation prompts.

Routes to the right CLI based on model:
  - Claude models (haiku, sonnet, opus) → Claude CLI
  - Everything else (gpt-5, chatgpt-5.3, ...) → Cursor agent

Beads with a model:<name> label automatically use that model.

Usage:
  ralph [options]

Options:
  --label <label>   Filter beads by label (works on any beads if omitted)
  --max <n>         Maximum iterations: number or "unlimited" (default: unlimited)
  --model <model>   Default model (default: haiku). Claude models use Claude CLI;
                    others use Cursor agent CLI.
  --retries <n>     Max retries per bead if context exhausted (default: 5)
  --queue <spec>    Explicit bead queue with per-bead models
                    Format: id:model,id:model,...
                    Model defaults to bead label, then --model if omitted
  -h, --help        Show this help

Examples:
  ralph --label api-cleanup --max 10
  ralph --label bug --model sonnet --retries 3
  ralph --model chatgpt-5.3           # Use ChatGPT via Cursor agent
  ralph  # Works on any ready beads

  # Queue mode: process specific beads with specific models
  ralph --queue "bd-21cp:sonnet,bd-35y4:chatgpt-5.3,bd-1lzt:opus"
  ralph --queue "bd-abc,bd-def" --model haiku  # All use haiku

  # Bead labels: add model:opus to a bead and ralph auto-selects it
  br label add bd-21cp model:opus

Requirements:
  - Claude CLI (claude) for Claude models: https://docs.anthropic.com/en/docs/claude-cli
  - Cursor CLI (cursor) for other models: https://cursor.com/cli
  - beads_rust (br) installed: https://github.com/sasha-incorporated/beads_rust
  - Run from a directory with .beads/issues.jsonl (or parent)

Install:
  curl -fsSL https://raw.githubusercontent.com/sasha-incorporated/ralph/main/ralph -o ~/.local/bin/ralph
  chmod +x ~/.local/bin/ralph
EOF
  exit 0
}

# Parse arguments
while [[ $# -gt 0 ]]; do
  case $1 in
    --label)
      LABEL="$2"
      shift 2
      ;;
    --max)
      MAX_ITERATIONS="$2"
      shift 2
      ;;
    --model)
      MODEL="$2"
      shift 2
      ;;
    --retries)
      MAX_RETRIES="$2"
      shift 2
      ;;
    --queue)
      QUEUE="$2"
      shift 2
      ;;
    -h|--help)
      show_help
      ;;
    *)
      echo "Unknown option: $1"
      echo "Use --help for usage information."
      exit 1
      ;;
  esac
done

# Check for br command
if ! command -v br &> /dev/null; then
  echo "Error: 'br' (beads_rust) not found. Install from: https://github.com/sasha-incorporated/beads_rust"
  exit 1
fi

# Check for CLI tools based on default model
if is_claude_model "$MODEL"; then
  if ! command -v claude &> /dev/null; then
    echo "Error: 'claude' CLI not found (needed for model '$MODEL')."
    echo "Install from: https://docs.anthropic.com/en/docs/claude-cli"
    exit 1
  fi
else
  if ! command -v cursor &> /dev/null; then
    echo "Error: 'cursor' CLI not found (needed for model '$MODEL')."
    echo "Install from: https://cursor.com/cli"
    exit 1
  fi
fi

# Parse queue if provided (using parallel arrays for bash 3.x compatibility)
QUEUE_IDS=()
QUEUE_MODELS_LIST=()

if [[ -n "$QUEUE" ]]; then
  # Parse comma-separated items
  IFS=',' read -ra QUEUE_ITEMS <<< "$QUEUE"
  for item in "${QUEUE_ITEMS[@]}"; do
    # Trim whitespace
    item=$(echo "$item" | xargs)
    if [[ "$item" == *":"* ]]; then
      # Format: id:model (explicit model override)
      bead_id="${item%%:*}"
      bead_model="${item#*:}"
    else
      # Format: id only — will check bead labels later, then fall back to --model
      bead_id="$item"
      bead_model=""
    fi
    QUEUE_IDS+=("$bead_id")
    QUEUE_MODELS_LIST+=("$bead_model")
  done

  # Set max iterations to queue length if not explicitly set
  if [[ "$MAX_ITERATIONS" == "unlimited" ]]; then
    MAX_ITERATIONS=${#QUEUE_IDS[@]}
  fi
fi

echo "=== Ralph Starting ==="
if [[ -n "$QUEUE" ]]; then
  echo "Mode: Queue (${#QUEUE_IDS[@]} beads)"
  for i in "${!QUEUE_IDS[@]}"; do
    local_model="${QUEUE_MODELS_LIST[$i]}"
    echo "  - ${QUEUE_IDS[$i]} (${local_model:-auto})"
  done
else
  echo "Mode: Auto-discovery"
  echo "Default model: $MODEL"
  [[ -n "$LABEL" ]] && echo "Label filter: $LABEL"
fi
[[ "$MAX_ITERATIONS" != "unlimited" ]] && echo "Max iterations: $MAX_ITERATIONS"
echo "Max retries per bead: $MAX_RETRIES"
echo ""

# Main loop
ITERATION=0
COMPLETED=0
QUEUE_INDEX=0

while true; do
  ITERATION=$((ITERATION + 1))

  # Check iteration limit
  if [[ "$MAX_ITERATIONS" != "unlimited" && "$ITERATION" -gt "$MAX_ITERATIONS" ]]; then
    echo ""
    echo "=== Reached maximum iterations ($MAX_ITERATIONS). Completed $COMPLETED beads. ==="
    exit 0
  fi

  # zero-pad ITERATION to 3 digits
  itr=$(printf "%03d" $ITERATION)
  echo ""
  echo "==============================================="
  echo "===              Iteration $itr              ==="
  echo "===  Started: $(date)  ==="
  echo "==============================================="

  # Get next bead - either from queue or auto-discovery
  if [[ -n "$QUEUE" ]]; then
    # Queue mode: get next bead from queue
    if [[ "$QUEUE_INDEX" -ge "${#QUEUE_IDS[@]}" ]]; then
      echo "Queue exhausted."
      echo ""
      echo "=== All done! Completed $COMPLETED beads from queue. ==="
      exit 0
    fi

    BEAD_ID="${QUEUE_IDS[$QUEUE_INDEX]}"
    CURRENT_MODEL="${QUEUE_MODELS_LIST[$QUEUE_INDEX]}"
    QUEUE_INDEX=$((QUEUE_INDEX + 1))

    # Fetch bead details
    BEAD_JSON=$(br show "$BEAD_ID" --json 2>/dev/null || echo '{"data":{"issues":[]}}')
    BEAD_COUNT=$(echo "$BEAD_JSON" | jq '.data.issues | length')

    if [[ "$BEAD_COUNT" -eq 0 ]]; then
      echo "⚠ Bead $BEAD_ID not found, skipping..."
      continue
    fi

    BEAD_TITLE=$(echo "$BEAD_JSON" | jq -r '.data.issues[0].title')
    BEAD_DESC=$(echo "$BEAD_JSON" | jq -r '.data.issues[0].description // "No description"')

    # Resolve model: queue explicit > bead label > --model default
    if [[ -z "$CURRENT_MODEL" ]]; then
      LABEL_MODEL=$(extract_model_from_labels "$(echo "$BEAD_JSON" | jq '.data.issues[0].labels // []')")
      if [[ -n "$LABEL_MODEL" ]]; then
        CURRENT_MODEL="$LABEL_MODEL"
        echo "Queue item $QUEUE_INDEX/${#QUEUE_IDS[@]}: $BEAD_ID (model: $CURRENT_MODEL ← bead label)"
      else
        CURRENT_MODEL="$MODEL"
        echo "Queue item $QUEUE_INDEX/${#QUEUE_IDS[@]}: $BEAD_ID (model: $CURRENT_MODEL ← default)"
      fi
    else
      echo "Queue item $QUEUE_INDEX/${#QUEUE_IDS[@]}: $BEAD_ID (model: $CURRENT_MODEL)"
    fi
  else
    # Auto-discovery mode: find next ready bead
    echo "Looking for ready work..."
    if [[ -n "$LABEL" ]]; then
      READY_OUTPUT=$(br ready --label "$LABEL" --limit 1 --json 2>/dev/null || echo '{"data":{"issues":[]}}')
    else
      READY_OUTPUT=$(br ready --limit 1 --json 2>/dev/null || echo '{"data":{"issues":[]}}')
    fi

    # Check if there are any beads
    BEAD_COUNT=$(echo "$READY_OUTPUT" | jq '.data.issues | length')
    if [[ "$BEAD_COUNT" -eq 0 ]]; then
      echo "No ready beads found${LABEL:+ with label '$LABEL'}."
      echo ""
      echo "=== All done! Completed $COMPLETED beads in $((ITERATION - 1)) iterations. ==="
      exit 0
    fi

    BEAD_ID=$(echo "$READY_OUTPUT" | jq -r '.data.issues[0].id')
    BEAD_TITLE=$(echo "$READY_OUTPUT" | jq -r '.data.issues[0].title')
    BEAD_DESC=$(echo "$READY_OUTPUT" | jq -r '.data.issues[0].description // "No description"')

    # Check bead labels for model override
    LABEL_MODEL=$(extract_model_from_labels "$(echo "$READY_OUTPUT" | jq '.data.issues[0].labels // []')")
    if [[ -n "$LABEL_MODEL" ]]; then
      CURRENT_MODEL="$LABEL_MODEL"
      echo "Model from bead label: $CURRENT_MODEL"
    else
      CURRENT_MODEL="$MODEL"
    fi
  fi

  echo "Bead: $BEAD_ID"
  echo "Title: $BEAD_TITLE"
  echo "Model: $CURRENT_MODEL"

  # Double-check bead is still open (race condition protection)
  BEAD_STATUS=$(br show "$BEAD_ID" --json 2>/dev/null | jq -r '.data.issues[0].status' || echo "unknown")
  if [[ "$BEAD_STATUS" == "closed" || "$BEAD_STATUS" == "done" ]]; then
    echo "⚠ Bead already closed, skipping to next..."
    continue
  fi
  echo ""

  # Retry loop for this bead
  RETRY=0
  BEAD_DONE=false

  while [[ "$RETRY" -lt "$MAX_RETRIES" && "$BEAD_DONE" == "false" ]]; do
    RETRY=$((RETRY + 1))

    if [[ "$RETRY" -gt 1 ]]; then
      echo ""
      echo "--- Retry $RETRY/$MAX_RETRIES for $BEAD_ID ---"
    fi

    # Build the prompt
    RETRY_NOTE=""
    if [[ "$RETRY" -gt 1 ]]; then
      RETRY_NOTE="
**NOTE: This is retry attempt $RETRY of $MAX_RETRIES.** A previous agent ran out of context or failed. Pick up where they left off - check git status, review any partial work, and complete the task.
"
    fi

    PROMPT=$(cat <<EOF
You are Ralph, an autonomous bead worker. Complete this bead and commit your work.

## Current Bead: $BEAD_ID

**Title:** $BEAD_TITLE
**Model:** $CURRENT_MODEL
$RETRY_NOTE
**Description:**
$BEAD_DESC

## Your Mission

1. **Understand** - Read the bead carefully, including any acceptance criteria
2. **Execute** - Make all code changes needed to satisfy requirements
3. **Verify** - Run tests/lint to ensure acceptance criteria pass
4. **Close** - Run: \`br close $BEAD_ID\`
5. **Commit** - Stage and commit with a meaningful message

## Rules

- Complete the bead FULLY before closing
- If you CANNOT complete it (blocked, unclear requirements), leave a note in the bead description and do NOT close it
- ALWAYS commit your work before finishing
- Work ONLY on this bead, nothing else

GO!
EOF
    )

    # Invoke the model (routes to Claude CLI or Cursor agent)
    if is_claude_model "$CURRENT_MODEL"; then
      echo "Invoking Claude CLI with model: $CURRENT_MODEL..."
    else
      echo "Invoking Cursor agent with model: $CURRENT_MODEL..."
    fi
    echo ""

    set +e
    invoke_model "$CURRENT_MODEL" "$PROMPT"
    AGENT_EXIT=$?
    set -e

    echo ""
    echo "--- Agent exited with code: $AGENT_EXIT ---"

    # Check if bead was closed
    sleep 2  # Give br a moment to sync
    BEAD_STATUS=$(br show "$BEAD_ID" --json 2>/dev/null | jq -r '.data.issues[0].status' || echo "unknown")
    echo "Bead status: $BEAD_STATUS"

    if [[ "$BEAD_STATUS" == "closed" || "$BEAD_STATUS" == "done" ]]; then
      echo "✓ Bead $BEAD_ID completed successfully!"
      BEAD_DONE=true
      COMPLETED=$((COMPLETED + 1))
    elif [[ "$RETRY" -ge "$MAX_RETRIES" ]]; then
      echo "✗ Bead $BEAD_ID failed after $MAX_RETRIES attempts. Skipping."
    else
      echo "Bead not closed. Will retry..."
      sleep 3
    fi
  done
done

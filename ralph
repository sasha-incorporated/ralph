#!/usr/bin/env bash
#
# ralph - AI bead worker loop (YOLO mode)
#
# Autonomous bead worker: picks up ready work, completes it, commits, then
# loops to the next bead. Routes to Claude CLI or Cursor agent based on model.
# Beads with a model:<name> label automatically use that model.
#
# Usage:
#   ralph [--label <label>] [--max <n>] [--model <model>] [--retries <n>]
#   ralph --queue "id:model,id:model,..."
#   ralph --progress          # Show progress of current/last run
#   ralph --output [--tail]   # Show full output or tail it
#
# Options:
#   --label <label>   Filter beads by label (works on any beads if omitted)
#   --max <n>         Maximum iterations (default: unlimited)
#   --model <model>   Default model (default: haiku). Claude models (haiku,
#                     sonnet, opus) use Claude CLI; others use Cursor agent.
#   --retries <n>     Max retries per bead (default: 5)
#   --queue <spec>    Explicit queue with per-bead models (format: id:model,id:model,...)
#   --timeout <sec>   Per-bead timeout in seconds (default: 900 = 15min)
#   --progress        Show progress summary of current/last run
#   --output          Show full output log of current/last run
#   --tail            With --output: follow the log in real-time (like tail -f)
#   --log-dir <dir>   Custom log directory (default: ~/.ralph/logs)
#

set -euo pipefail

# --- Constants ---

# Models that use Claude CLI; everything else routes to cursor agent
CLAUDE_MODELS="haiku sonnet opus"

# Log directory
DEFAULT_LOG_DIR="${HOME}/.ralph/logs"

# Default per-bead timeout (15 minutes)
DEFAULT_TIMEOUT=900

# Find timeout command (macOS coreutils uses gtimeout)
if command -v timeout &> /dev/null; then
  TIMEOUT_CMD="timeout"
elif command -v gtimeout &> /dev/null; then
  TIMEOUT_CMD="gtimeout"
else
  TIMEOUT_CMD=""
fi

# --- Helpers ---

is_claude_model() {
  [[ " $CLAUDE_MODELS " == *" $1 "* ]]
}

# Extract model from bead labels (looks for model:<name> label)
extract_model_from_labels() {
  local labels_json="$1"
  echo "$labels_json" | jq -r '.[] | select(startswith("model:")) | sub("^model:"; "")' 2>/dev/null | head -1
}

# Invoke the right CLI based on model type, with optional timeout
invoke_model() {
  local model="$1"
  local prompt="$2"
  local timeout_prefix=""

  if [[ -n "$TIMEOUT_CMD" && "$BEAD_TIMEOUT" -gt 0 ]]; then
    timeout_prefix="$TIMEOUT_CMD --signal=TERM --kill-after=30 ${BEAD_TIMEOUT}"
  fi

  if is_claude_model "$model"; then
    $timeout_prefix claude --model "$model" --print --dangerously-skip-permissions "$prompt" < /dev/null
  else
    $timeout_prefix cursor agent --model "$model" --print --yolo --trust "$prompt" < /dev/null
  fi
}

# --- Logging ---

setup_logging() {
  mkdir -p "$LOG_DIR"
  LOG_FILE="$LOG_DIR/latest.log"
  PROGRESS_FILE="$LOG_DIR/progress.json"

  # Initialize progress file
  cat > "$PROGRESS_FILE" <<PEOF
{
  "status": "starting",
  "started_at": "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
  "pid": $$,
  "completed": 0,
  "failed": 0,
  "skipped": 0,
  "total": 0,
  "current_bead": null,
  "current_model": null,
  "current_iteration": 0,
  "beads": []
}
PEOF
}

update_progress() {
  local updates="$1"
  local tmp_file="${PROGRESS_FILE}.tmp"
  jq "$updates" "$PROGRESS_FILE" > "$tmp_file" 2>/dev/null && mv "$tmp_file" "$PROGRESS_FILE"
}

record_bead_result() {
  local bead_id="$1"
  local title="$2"
  local model="$3"
  local result="$4"  # completed|failed|skipped
  local tmp_file="${PROGRESS_FILE}.tmp"
  jq --arg id "$bead_id" --arg t "$title" --arg m "$model" --arg r "$result" --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '.beads += [{"id": $id, "title": $t, "model": $m, "result": $r, "finished_at": $ts}]' \
    "$PROGRESS_FILE" > "$tmp_file" 2>/dev/null && mv "$tmp_file" "$PROGRESS_FILE"
}

# --- Progress / Output commands ---

show_progress() {
  local pfile="$LOG_DIR/progress.json"
  if [[ ! -f "$pfile" ]]; then
    echo "No ralph run found. Log directory: $LOG_DIR"
    exit 1
  fi

  echo "=== Ralph Progress ==="
  echo ""

  local status completed failed skipped total current_bead current_model started_at pid
  status=$(jq -r '.status' "$pfile")
  completed=$(jq -r '.completed' "$pfile")
  failed=$(jq -r '.failed' "$pfile")
  skipped=$(jq -r '.skipped' "$pfile")
  total=$(jq -r '.total' "$pfile")
  current_bead=$(jq -r '.current_bead // "none"' "$pfile")
  current_model=$(jq -r '.current_model // "—"' "$pfile")
  started_at=$(jq -r '.started_at' "$pfile")
  pid=$(jq -r '.pid' "$pfile")

  # Check if process is still running
  local running="no"
  if kill -0 "$pid" 2>/dev/null; then
    running="yes"
  fi

  echo "Status:    $status (pid $pid, running: $running)"
  echo "Started:   $started_at"
  echo "Progress:  $completed completed, $failed failed, $skipped skipped / $total total"
  if [[ "$current_bead" != "none" && "$current_bead" != "null" ]]; then
    echo "Current:   $current_bead ($current_model)"
  fi
  echo ""

  # Show bead results
  local bead_count
  bead_count=$(jq '.beads | length' "$pfile")
  if [[ "$bead_count" -gt 0 ]]; then
    echo "--- Bead Results ---"
    jq -r '.beads[] | "  " + (if .result == "completed" then "✓" elif .result == "failed" then "✗" else "⊘" end) + " " + .id + " " + .result + " (" + .model + ") — " + .title' "$pfile"
    echo ""
  fi

  # Show remaining queue items
  local remaining=$((total - completed - failed - skipped))
  if [[ "$remaining" -gt 0 ]]; then
    echo "$remaining beads remaining"
  fi

  exit 0
}

show_output() {
  local log="$LOG_DIR/latest.log"
  if [[ ! -f "$log" ]]; then
    echo "No ralph log found. Log directory: $LOG_DIR"
    exit 1
  fi

  if [[ "$TAIL_MODE" == "true" ]]; then
    echo "=== Following ralph output (Ctrl+C to stop) ==="
    tail -f "$log"
  else
    cat "$log"
  fi
  exit 0
}

# --- Defaults ---

LABEL=""
MAX_ITERATIONS="unlimited"
MODEL="haiku"
MAX_RETRIES=5
QUEUE=""
BEAD_TIMEOUT="$DEFAULT_TIMEOUT"
LOG_DIR="$DEFAULT_LOG_DIR"
SHOW_PROGRESS=false
SHOW_OUTPUT=false
TAIL_MODE=false

# --- Help ---

show_help() {
  cat <<EOF
ralph - AI bead worker loop (YOLO mode)

Autonomous bead worker: picks up ready work, completes it, commits, then
loops to the next bead. Fully autonomous - no confirmation prompts.

Routes to the right CLI based on model:
  - Claude models (haiku, sonnet, opus) → Claude CLI
  - Everything else (gpt-5, chatgpt-5.3, ...) → Cursor agent

Beads with a model:<name> label automatically use that model.

Usage:
  ralph [options]

Options:
  --label <label>   Filter beads by label (works on any beads if omitted)
  --max <n>         Maximum iterations: number or "unlimited" (default: unlimited)
  --model <model>   Default model (default: haiku). Claude models use Claude CLI;
                    others use Cursor agent CLI.
  --retries <n>     Max retries per bead if context exhausted (default: 5)
  --timeout <sec>   Per-bead timeout in seconds (default: 900 = 15min).
                    If an agent hangs, it's killed and the bead retries.
  --queue <spec>    Explicit bead queue with per-bead models
                    Format: id:model,id:model,...
                    Model defaults to bead label, then --model if omitted
  --progress        Show progress summary of current/last run
  --output          Show full output log of current/last run
  --tail            With --output: follow the log in real-time
  --log-dir <dir>   Custom log directory (default: ~/.ralph/logs)
  -h, --help        Show this help

Examples:
  ralph --label api-cleanup --max 10
  ralph --label bug --model sonnet --retries 3
  ralph --model chatgpt-5.3           # Use ChatGPT via Cursor agent
  ralph  # Works on any ready beads

  # Queue mode: process specific beads with specific models
  ralph --queue "bd-21cp:sonnet,bd-35y4:chatgpt-5.3,bd-1lzt:opus"
  ralph --queue "bd-abc,bd-def" --model haiku  # All use haiku

  # Check on a running ralph from another terminal
  ralph --progress                    # Summary: completed/failed/remaining
  ralph --output                      # Full log output
  ralph --output --tail               # Follow log in real-time

  # Bead labels: add model:opus to a bead and ralph auto-selects it
  br label add bd-21cp model:opus

Requirements:
  - Claude CLI (claude) for Claude models: https://docs.anthropic.com/en/docs/claude-cli
  - Cursor CLI (cursor) for other models: https://cursor.com/cli
  - beads_rust (br) installed: https://github.com/sasha-incorporated/beads_rust
  - Run from a directory with .beads/issues.jsonl (or parent)

Install:
  curl -fsSL https://raw.githubusercontent.com/sasha-incorporated/ralph/main/ralph -o ~/.local/bin/ralph
  chmod +x ~/.local/bin/ralph
EOF
  exit 0
}

# --- Parse arguments ---

while [[ $# -gt 0 ]]; do
  case $1 in
    --label)
      LABEL="$2"
      shift 2
      ;;
    --max)
      MAX_ITERATIONS="$2"
      shift 2
      ;;
    --model)
      MODEL="$2"
      shift 2
      ;;
    --retries)
      MAX_RETRIES="$2"
      shift 2
      ;;
    --queue)
      QUEUE="$2"
      shift 2
      ;;
    --timeout)
      BEAD_TIMEOUT="$2"
      shift 2
      ;;
    --progress)
      SHOW_PROGRESS=true
      shift
      ;;
    --output)
      SHOW_OUTPUT=true
      shift
      ;;
    --tail)
      TAIL_MODE=true
      shift
      ;;
    --log-dir)
      LOG_DIR="$2"
      shift 2
      ;;
    -h|--help)
      show_help
      ;;
    *)
      echo "Unknown option: $1"
      echo "Use --help for usage information."
      exit 1
      ;;
  esac
done

# Handle read-only commands (no need for br/claude checks)
if [[ "$SHOW_PROGRESS" == "true" ]]; then
  show_progress
fi

if [[ "$SHOW_OUTPUT" == "true" ]]; then
  show_output
fi

# --- Pre-flight checks ---

if ! command -v br &> /dev/null; then
  echo "Error: 'br' (beads_rust) not found. Install from: https://github.com/sasha-incorporated/beads_rust"
  exit 1
fi

# Check for CLI tools based on default model
if is_claude_model "$MODEL"; then
  if ! command -v claude &> /dev/null; then
    echo "Error: 'claude' CLI not found (needed for model '$MODEL')."
    echo "Install from: https://docs.anthropic.com/en/docs/claude-cli"
    exit 1
  fi
else
  if ! command -v cursor &> /dev/null; then
    echo "Error: 'cursor' CLI not found (needed for model '$MODEL')."
    echo "Install from: https://cursor.com/cli"
    exit 1
  fi
fi

# --- Parse queue ---

QUEUE_IDS=()
QUEUE_MODELS_LIST=()

if [[ -n "$QUEUE" ]]; then
  IFS=',' read -ra QUEUE_ITEMS <<< "$QUEUE"
  for item in "${QUEUE_ITEMS[@]}"; do
    item=$(echo "$item" | xargs)
    if [[ "$item" == *":"* ]]; then
      bead_id="${item%%:*}"
      bead_model="${item#*:}"
    else
      bead_id="$item"
      bead_model=""
    fi
    QUEUE_IDS+=("$bead_id")
    QUEUE_MODELS_LIST+=("$bead_model")
  done

  if [[ "$MAX_ITERATIONS" == "unlimited" ]]; then
    MAX_ITERATIONS=${#QUEUE_IDS[@]}
  fi
fi

# --- Setup logging (tee all output to log file) ---

setup_logging
exec > >(tee -a "$LOG_FILE") 2>&1

# --- Banner ---

echo "=== Ralph Starting ==="
if [[ -n "$QUEUE" ]]; then
  echo "Mode: Queue (${#QUEUE_IDS[@]} beads)"
  for i in "${!QUEUE_IDS[@]}"; do
    local_model="${QUEUE_MODELS_LIST[$i]}"
    echo "  - ${QUEUE_IDS[$i]} (${local_model:-auto})"
  done
  update_progress ".total = ${#QUEUE_IDS[@]}"
else
  echo "Mode: Auto-discovery"
  echo "Default model: $MODEL"
  [[ -n "$LABEL" ]] && echo "Label filter: $LABEL"
fi
[[ "$MAX_ITERATIONS" != "unlimited" ]] && echo "Max iterations: $MAX_ITERATIONS"
echo "Max retries per bead: $MAX_RETRIES"
if [[ -n "$TIMEOUT_CMD" ]]; then
  echo "Per-bead timeout: ${BEAD_TIMEOUT}s"
else
  echo "Per-bead timeout: disabled (install coreutils for timeout support)"
fi
echo "Log: $LOG_FILE"
echo "Progress: ralph --progress"
echo ""

update_progress '.status = "running"'

# --- Main loop ---

ITERATION=0
COMPLETED=0
FAILED=0
SKIPPED=0
QUEUE_INDEX=0

while true; do
  ITERATION=$((ITERATION + 1))

  if [[ "$MAX_ITERATIONS" != "unlimited" && "$ITERATION" -gt "$MAX_ITERATIONS" ]]; then
    echo ""
    echo "=== Reached maximum iterations ($MAX_ITERATIONS). Completed $COMPLETED beads. ==="
    update_progress ".status = \"finished\" | .completed = $COMPLETED | .failed = $FAILED | .skipped = $SKIPPED"
    exit 0
  fi

  itr=$(printf "%03d" $ITERATION)
  echo ""
  echo "==============================================="
  echo "===              Iteration $itr              ==="
  echo "===  Started: $(date)  ==="
  echo "==============================================="

  # --- Get next bead ---

  if [[ -n "$QUEUE" ]]; then
    if [[ "$QUEUE_INDEX" -ge "${#QUEUE_IDS[@]}" ]]; then
      echo "Queue exhausted."
      echo ""
      echo "=== All done! Completed $COMPLETED beads from queue. ==="
      update_progress ".status = \"finished\" | .completed = $COMPLETED | .failed = $FAILED | .skipped = $SKIPPED"
      exit 0
    fi

    BEAD_ID="${QUEUE_IDS[$QUEUE_INDEX]}"
    CURRENT_MODEL="${QUEUE_MODELS_LIST[$QUEUE_INDEX]}"
    QUEUE_INDEX=$((QUEUE_INDEX + 1))

    # br show --json returns {"data":{...}} or [{...}] depending on version
    BEAD_JSON_RAW=$(br show "$BEAD_ID" --json 2>/dev/null || echo '{}')
    # Normalize: extract the bead object regardless of wrapper format
    BEAD_OBJ=$(echo "$BEAD_JSON_RAW" | jq 'if type == "array" then .[0] // null elif .data then .data else . end')

    if [[ "$BEAD_OBJ" == "null" || -z "$BEAD_OBJ" ]]; then
      echo "⚠ Bead $BEAD_ID not found, skipping..."
      SKIPPED=$((SKIPPED + 1))
      update_progress ".skipped = $SKIPPED | .current_iteration = $ITERATION"
      continue
    fi

    BEAD_TITLE=$(echo "$BEAD_OBJ" | jq -r '.title')
    BEAD_DESC=$(echo "$BEAD_OBJ" | jq -r '.description // "No description"')

    # Resolve model: queue explicit > bead label > --model default
    if [[ -z "$CURRENT_MODEL" ]]; then
      LABEL_MODEL=$(extract_model_from_labels "$(echo "$BEAD_OBJ" | jq '.labels // []')")
      if [[ -n "$LABEL_MODEL" ]]; then
        CURRENT_MODEL="$LABEL_MODEL"
        echo "Queue item $QUEUE_INDEX/${#QUEUE_IDS[@]}: $BEAD_ID (model: $CURRENT_MODEL ← bead label)"
      else
        CURRENT_MODEL="$MODEL"
        echo "Queue item $QUEUE_INDEX/${#QUEUE_IDS[@]}: $BEAD_ID (model: $CURRENT_MODEL ← default)"
      fi
    else
      echo "Queue item $QUEUE_INDEX/${#QUEUE_IDS[@]}: $BEAD_ID (model: $CURRENT_MODEL)"
    fi
  else
    # Auto-discovery mode
    echo "Looking for ready work..."
    if [[ -n "$LABEL" ]]; then
      # br ready doesn't support --label, so use br list with status+label filter
      READY_OUTPUT=$(br list --status open --label "$LABEL" --limit 1 --sort priority --json 2>/dev/null || echo '{"data":{"issues":[]}}')
    else
      READY_OUTPUT=$(br ready --limit 1 --json 2>/dev/null || echo '{"data":{"issues":[]}}')
    fi

    # Normalize output: br has multiple JSON formats depending on command/version:
    #   br ready:  {"data":{"issues":[...]}}
    #   br list:   {"data":[...]}
    #   legacy:    [{...}]  (plain array)
    ISSUES=$(echo "$READY_OUTPUT" | jq '
      if type == "array" then .
      elif (.data | type) == "array" then .data
      elif .data.issues then .data.issues
      else []
      end')
    BEAD_COUNT=$(echo "$ISSUES" | jq 'length')
    if [[ "$BEAD_COUNT" -eq 0 ]]; then
      echo "No ready beads found${LABEL:+ with label '$LABEL'}."
      echo ""
      echo "=== All done! Completed $COMPLETED beads in $((ITERATION - 1)) iterations. ==="
      update_progress ".status = \"finished\" | .completed = $COMPLETED | .failed = $FAILED | .skipped = $SKIPPED"
      exit 0
    fi

    BEAD_ID=$(echo "$ISSUES" | jq -r '.[0].id')
    BEAD_TITLE=$(echo "$ISSUES" | jq -r '.[0].title')
    BEAD_DESC=$(echo "$ISSUES" | jq -r '.[0].description // "No description"')

    # Check bead labels for model override
    LABEL_MODEL=$(extract_model_from_labels "$(echo "$ISSUES" | jq '.[0].labels // []')")
    if [[ -n "$LABEL_MODEL" ]]; then
      CURRENT_MODEL="$LABEL_MODEL"
      echo "Model from bead label: $CURRENT_MODEL"
    else
      CURRENT_MODEL="$MODEL"
    fi
  fi

  echo "Bead: $BEAD_ID"
  echo "Title: $BEAD_TITLE"
  echo "Model: $CURRENT_MODEL"

  update_progress ".current_bead = \"$BEAD_ID\" | .current_model = \"$CURRENT_MODEL\" | .current_iteration = $ITERATION"

  # Double-check bead is still open
  BEAD_STATUS=$(br show "$BEAD_ID" --json 2>/dev/null | jq -r '.[0].status' || echo "unknown")
  if [[ "$BEAD_STATUS" == "closed" || "$BEAD_STATUS" == "done" ]]; then
    echo "⚠ Bead already closed, skipping to next..."
    SKIPPED=$((SKIPPED + 1))
    record_bead_result "$BEAD_ID" "$BEAD_TITLE" "$CURRENT_MODEL" "skipped"
    update_progress ".skipped = $SKIPPED"
    continue
  fi
  echo ""

  # --- Retry loop ---

  RETRY=0
  BEAD_DONE=false

  while [[ "$RETRY" -lt "$MAX_RETRIES" && "$BEAD_DONE" == "false" ]]; do
    RETRY=$((RETRY + 1))

    if [[ "$RETRY" -gt 1 ]]; then
      echo ""
      echo "--- Retry $RETRY/$MAX_RETRIES for $BEAD_ID ---"
    fi

    RETRY_NOTE=""
    if [[ "$RETRY" -gt 1 ]]; then
      RETRY_NOTE="
**NOTE: This is retry attempt $RETRY of $MAX_RETRIES.** A previous agent ran out of context or failed. Pick up where they left off - check git status, review any partial work, and complete the task.
"
    fi

    PROMPT=$(cat <<EOF
You are Ralph, an autonomous bead worker. Complete this bead and commit your work.

## Current Bead: $BEAD_ID

**Title:** $BEAD_TITLE
**Model:** $CURRENT_MODEL
$RETRY_NOTE
**Description:**
$BEAD_DESC

## Your Mission

1. **Understand** - Read the bead carefully, including any acceptance criteria
2. **Execute** - Make all code changes needed to satisfy requirements
3. **Verify** - Run tests/lint to ensure acceptance criteria pass
4. **Close** - Run: \`br close $BEAD_ID\`
5. **Commit** - Stage and commit with a meaningful message

## Rules

- Complete the bead FULLY before closing
- If you CANNOT complete it (blocked, unclear requirements), leave a note in the bead description and do NOT close it
- ALWAYS commit your work before finishing
- Work ONLY on this bead, nothing else

GO!
EOF
    )

    if is_claude_model "$CURRENT_MODEL"; then
      echo "Invoking Claude CLI with model: $CURRENT_MODEL..."
    else
      echo "Invoking Cursor agent with model: $CURRENT_MODEL..."
    fi
    echo ""

    set +e
    invoke_model "$CURRENT_MODEL" "$PROMPT"
    AGENT_EXIT=$?
    set -e

    echo ""
    if [[ "$AGENT_EXIT" -eq 124 ]]; then
      echo "--- Agent TIMED OUT after ${BEAD_TIMEOUT}s (killed) ---"
    else
      echo "--- Agent exited with code: $AGENT_EXIT ---"
    fi

    sleep 2
    BEAD_STATUS=$(br show "$BEAD_ID" --json 2>/dev/null | jq -r '.[0].status' || echo "unknown")
    echo "Bead status: $BEAD_STATUS"

    if [[ "$BEAD_STATUS" == "closed" || "$BEAD_STATUS" == "done" ]]; then
      echo "✓ Bead $BEAD_ID completed successfully!"
      BEAD_DONE=true
      COMPLETED=$((COMPLETED + 1))
      record_bead_result "$BEAD_ID" "$BEAD_TITLE" "$CURRENT_MODEL" "completed"
      update_progress ".completed = $COMPLETED | .current_bead = null"
    elif [[ "$RETRY" -ge "$MAX_RETRIES" ]]; then
      echo "✗ Bead $BEAD_ID failed after $MAX_RETRIES attempts. Skipping."
      FAILED=$((FAILED + 1))
      record_bead_result "$BEAD_ID" "$BEAD_TITLE" "$CURRENT_MODEL" "failed"
      update_progress ".failed = $FAILED | .current_bead = null"
    else
      echo "Bead not closed. Will retry..."
      sleep 3
    fi
  done
done
